# Environment variables — copy this file to .env and fill in your values.
# The .env file is NOT committed to source control.

# Base URL of this server — used wherever an absolute URL is needed
# (e.g. OAuth callbacks, email links, CORS allow-lists).
# In production set this to your public domain, e.g. https://labledger.example.com
BASE_URL=http://localhost:3000

# CORS — the origin(s) the frontend is served from.
# Comma-separated list. Must match the URL users type into their browser.
# Example (local + Vercel):
#   ALLOWED_ORIGIN=http://localhost:3000,https://myapp.vercel.app
ALLOWED_ORIGIN=http://localhost:3000

# PostgreSQL connection string
# Local:   postgres://postgres:password@localhost:5432/labledger
# Neon:    postgres://user:pass@ep-xxx.us-east-1.aws.neon.tech/labledger?sslmode=require
# Supabase:postgres://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgres://postgres:password@localhost:5432/labledger

# Session secret — use a long random string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-in-production
